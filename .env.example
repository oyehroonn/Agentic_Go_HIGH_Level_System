# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# GoHighLevel (Private Integration Token — Settings → Private Integrations)
GHL_API_KEY=
GHL_LOCATION_ID=
